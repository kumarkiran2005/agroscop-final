# AgroScope Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file itself

# DeepSeek AI API (get from platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Tavily Search API (get from tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# OpenCage Geocoding API (required for location-based agri news)
OPENCAGE_API_KEY=your_opencage_api_key_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agroscope

# JWT Authentication
JWT_SECRET=your_super_long_random_secret_string_here_minimum_32_chars
JWT_EXPIRES_IN=7d

# Server configuration
PORT=5000
NODE_ENV=development

# Frontend URL (set in Render production env for tighter CORS if needed)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional: Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: OpenWeatherMap (if used)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini — powers Detect Crop Type via Camera, Estimate Weight via Camera,
# and Negotiate Price with AI. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model. Pick one that is actually live for your key — many older ids
# (gemini-2.5-pro, gemini-3-pro-preview, gemini-2.0-flash, gemini-1.5-*) now
# return 404 even though ListModels still advertises them.
GEMINI_MODEL=gemini-3.5-flash

# Weight estimation accuracy/latency tuning.
# Independent passes run in parallel and the median is used, which cuts the
# single-shot spread dramatically. 3 is a good default; 1 is fastest and noisiest.
GEMINI_WEIGHT_SAMPLES=3
# Caps model "thinking" tokens to bound latency. Empty = model default.
GEMINI_THINKING_BUDGET=1024

# Which AI answers the negotiation chat: gemini | deepseek | auto
NEGOTIATION_AI_PROVIDER=auto

# Vision weight estimation (max image size in MB)
VISION_MAX_IMAGE_SIZE_MB=10

# Google Cloud Vision — OPTIONAL extra signal for crop detection.
# Note: Cloud Vision does NOT accept plain API keys (it returns 401
# CREDENTIALS_MISSING), so a Gemini/AI Studio key will not work here. It needs a
# Cloud Console key on a billing-enabled project, or a service account. Leave
# both unset to run crop detection on Gemini alone — that is the normal setup.
# GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Wallet & notifications (AgroScope balance wallet, withdrawals, receipts)
PLATFORM_FEE_PERCENT=30
# Email (withdrawal receipt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@agroscope.com
# WhatsApp (Twilio – withdrawal receipt)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
